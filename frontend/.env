# Google OAuth Configuration
# Get your Client ID from https://console.cloud.google.com/
# Steps:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a new project or select existing
# 3. Enable Google Identity Services API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add http://localhost:3000 to authorized JavaScript origins
# 6. Copy the Client ID here

# IMPORTANT: Replace with your actual Google Client ID from Google Cloud Console
REACT_APP_GOOGLE_CLIENT_ID=856476392108-qt7lfh4g2epl9sshm7h1savde8c4atrm.apps.googleusercontent.com

# Backend API URL
REACT_APP_API_URL=http://localhost:8080/api
