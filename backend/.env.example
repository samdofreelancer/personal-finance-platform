# Backend Configuration Template

# ============================================================
# GOOGLE OAUTH CONFIGURATION
# ============================================================
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create new project or select existing
# 3. Enable "Google Identity Services API"
# 4. Create OAuth 2.0 credentials (Web application type)
# 5. Add these URIs to "Authorized JavaScript origins":
#    - http://localhost:3000 (development)
#    - https://yourdomain.com (production)
# 6. Add these URIs to "Authorized redirect URIs":
#    - http://localhost:8080/api/auth/callback (optional, for auth code flow)
#    - https://yourdomain.com/api/auth/callback (production)
# 7. Copy Client ID and Secret below

export GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com"
export GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"

# ============================================================
# JWT CONFIGURATION
# ============================================================
# Generate a strong secret key (min 256 bits for HS256):
#
# macOS/Linux:
#   openssl rand -base64 32
#
# Windows (PowerShell):
#   [System.Convert]::ToBase64String([System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes(32))
#
# This key must be:
# - Kept secret and secure
# - Same across all server instances (for session persistence)
# - Stored in a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)

export JWT_SECRET="GENERATE_A_STRONG_256_BIT_SECRET_AND_PASTE_HERE"

# JWT expiration time in milliseconds (default 1 hour = 3600000)
export JWT_EXPIRATION="3600000"

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# For development: H2 is configured by default (in-memory)
# For production: Switch to PostgreSQL or MySQL

# PostgreSQL (production)
export DB_URL="jdbc:postgresql://localhost:5432/personal_finance"
export DB_USERNAME="postgres"
export DB_PASSWORD="your_db_password"
export DB_DRIVER="org.postgresql.Driver"
export DB_DIALECT="org.hibernate.dialect.PostgreSQL10Dialect"

# MySQL (alternative)
# export DB_URL="jdbc:mysql://localhost:3306/personal_finance"
# export DB_USERNAME="root"
# export DB_PASSWORD="your_password"
# export DB_DRIVER="com.mysql.cj.jdbc.Driver"
# export DB_DIALECT="org.hibernate.dialect.MySQL8Dialect"

# ============================================================
# SERVER CONFIGURATION
# ============================================================
# Port where backend runs (development)
export SERVER_PORT="8080"

# Context path for API endpoints
export SERVER_SERVLET_CONTEXT_PATH="/api"

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://yourdomain.com
export CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://yourdomain.com"

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
# Log levels: TRACE, DEBUG, INFO, WARN, ERROR
export LOG_LEVEL="DEBUG"
export LOG_LEVEL_SPRING="INFO"
export LOG_LEVEL_HIBERNATE="WARN"

# ============================================================
# ENVIRONMENT
# ============================================================
# dev, staging, prod
export ENVIRONMENT="dev"

# ============================================================
# OPTIONAL: EMAIL CONFIGURATION
# ============================================================
# For sending verification emails (not implemented yet)
export MAIL_HOST="smtp.gmail.com"
export MAIL_PORT="587"
export MAIL_USERNAME="your-email@gmail.com"
export MAIL_PASSWORD="your-app-password"
export MAIL_FROM="noreply@yourdomain.com"
